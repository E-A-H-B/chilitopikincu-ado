<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Titulo</title>
</head>
<body>
    <style>
         *{
                box-sizing: border-box;
            
            }
            body{
                background-color: rgb(0, 0, 0);
                font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
                margin: 0;
            }
            header{
                padding: 1rem;
                display: flex;
                justify-content: flex-end;
                background-color: #373b69;
            }
            .search{
                background-color: transparent;
                border: 2px solid #58c8e4;
                border-radius: 50px;
                font-family: inherit;
                font-size: 15px;
                padding: 0.5rem 1rem;
                color: #fff;
            }
            .search::placeholder{
                color:rgb(111, 243, 153);
            }
            .search:focus{
                outline: none;
                background-color: #4512ff;
            }
            main{
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
            }
            .movie{
                width: 300px;
                margin: 1rem;
                background-color: azure;
                box-shadow: reltive;
                overflow: hidden;
                border-radius: 3px;
            }
            .movie img{
                width: 100%;

            }
            .movie-info{
                color: #a47301;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 0.2rem;
                padding: 0.5rem 1rem 1rem;
                letter-spacing: 0.5px;
            }
            .movie-info h3{
                margin-top: 0;

            }
            .movie-info span{
                background-color: #373b69;
                padding: 0.25rem 0.5rem;
                border-radius: 3px;
                font-weight: bold;
            }
            .movie-info span.blue{
                color: blue;
            }
            .movie-info span.white{
                color: white;
            }
            .movie-info span.red{
                color: red;
            }
        
            .overview{
                background-color: #fff;
                padding: 2rem;
                position: absolute;
                left: 0;
                bottom: 0;
                right: 0;
                max-height: 100%;
                transform: translateY(101%);
                overflow-y: auto;
                transition: transform 0.3s ease-in;
            }   
    </style>

    <header>
        <form id="form">
            <input type="text" id="search" class="search" placeholder="Buscar Personaje">
        </form>
    </header>
    <main id="main">

    </main>

    <script>
        const API_URL = 'https://hp-api.onrender.com/api/characters';
        const API_URL2 = 'https://rickandmortyapi.com/api/character';
        const main = document.getElementById('main');
        const form = document.getElementById('form');
        const search = document.getElementById('search');

        getCharacters(API_URL, API_URL2);

        async function getCharacters(hp_url, rm_url) {
            const hp_res = await fetch(hp_url);
            const hp_data = await hp_res.json();
            showHPCharacters(hp_data.items || hp_data);

            const rm_res = await fetch(rm_url);
            const rm_data = await rm_res.json();
            showRMCharacters(rm_data.results || rm_data);
        }

        function showHPCharacters(characters) {
            main.innerHTML = '';
            characters.forEach((char) => {
                const { id, name, image, house, species } = char;
                const charElement = document.createElement('div');
                charElement.classList.add('user');
                charElement.innerHTML = `
                    <img src="${image}" alt="${name}">
                    <div class="user-info">
                        <h1>${id}</h1>
                        <h3>${name}</h3>
                        <br>
                        ${house || 'Sin casa'}
                    </div>
                    <div class="descripcion">
                        <p>Casa: ${house || 'Desconocida'} | Especie: ${species || 'Desconocida'}</p>
                    </div>
                `;
                main.appendChild(charElement);
            });
        }

        function showRMCharacters(characters) {
            characters.forEach((char) => {
                const { id, name, image, species, status, origin } = char;
                const charElement = document.createElement('div');
                charElement.classList.add('user');
                charElement.innerHTML = `
                    <img src="${image}" alt="${name}">
                    <div class="user-info">
                        <h1>${id}</h1>
                        <h3>${name}</h3>
                        <br>
                        ${species}
                    </div>
                    <div class="descripcion">
                        <p>Estado: ${status} | Especie: ${species} | Origen: ${origin.name}</p>
                    </div>
                `;
                main.appendChild(charElement);
            });
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const searchTerm = search.value.toLowerCase();
            if (searchTerm && searchTerm !== '') {
                getCharacters(API_URL + ?name=${searchTerm}, API_URL2 + ?name=${searchTerm});
                search.value = '';
            } else {
                window.location.reload();
            }
        });
    </script>
</body>        
</html>
